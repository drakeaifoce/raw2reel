# Only needed for calls to Meta; the isolated pipeline reads no backend config.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MUSE_SPARK_MODEL=muse-spark-1.3
MUSE_VOICE_MODEL=muse-voice-transcribe-1.0
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2

# Install FFmpeg separately, or set absolute paths to the executables.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_TIMEOUT_SECONDS=600

# Server-to-server HTTP authentication; separate from MODEL_API_KEY.
# Generate a random secret and configure the same value on the backend.
AI_SERVICE_TOKEN=
# Cloud-only v2 pipeline. No local neural models or weights.
SAM_MODEL=sam-3.1
CLOUD_DISCOVERY_FRAMES=16
CLOUD_MAX_OBSERVATIONS=32
CLOUD_TRACK_SECONDS=120
CLOUD_REVIEW_SECONDS=90
CLOUD_CLIP_SECONDS=8
CLOUD_ANALYSIS_FPS=5

# Deterministic face filters: after cloud detection, before thumbnails/grouping.
# Each switch is independent. Size is measured on the actual detection frame.
CLOUD_FACE_MIN_SIZE_ENABLED=true
CLOUD_FACE_MIN_SIZE_PX=32
CLOUD_FACE_DEDUP_ENABLED=true
CLOUD_FACE_DEDUP_IOU=0.7

# Structured logs on stderr; use console for local reading.
LOG_LEVEL=INFO
LOG_FORMAT=json
