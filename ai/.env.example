# Only needed for calls to Meta; the isolated pipeline reads no backend config.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MUSE_SPARK_MODEL=muse-spark-1.3
MUSE_VOICE_MODEL=muse-voice-transcribe-1.0
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2

# Install FFmpeg separately, or set absolute paths to the executables.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_TIMEOUT_SECONDS=600

# Server-to-server HTTP authentication; separate from MODEL_API_KEY.
# Generate a random secret and configure the same value on the backend.
AI_SERVICE_TOKEN=
