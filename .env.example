# Состав конфигурации всех сервисов. Значения здесь не хранятся — только ключи
# и описания. Боевые значения лежат в секретах Gitea Actions, откуда деплой
# рендерит /opt/raw2reel/secrets/app.env на хосте (права 600).
#
# Локально: скопировать в .env рядом с нужным приложением. Корневой .gitignore
# игнорирует .env и .env.*, но этот файл пропускает явным исключением.

# ---------------------------------------------------------------- общее
# Порт внутри контейнера. Снаружи приложения доступны только через Caddy,
# так что менять почти никогда не нужно.
PORT=3000

# ---------------------------------------------------------------- база
# Cosmos DB с Mongo-совместимым API. Строка подключения берётся из портала или
# командой: az cosmosdb keys list --type connection-strings -n <account> -g rg-raw2reel
# Пустое значение не роняет сервис: /ready покажет зависимость как unconfigured.
MONGO_URL=
MONGO_DB=raw2reel

# ---------------------------------------------------------------- файлы
# Azure Blob Storage, аккаунт straw2reel. S3-совместимости у Blob нет:
# в коде используются @azure/storage-blob и azure-storage-blob.
# az storage account show-connection-string -n straw2reel -g rg-raw2reel
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_UPLOADS=uploads
AZURE_BLOB_CONTAINER_RENDERS=renders

# Разрешённые MIME-типы (точные значения или группы с /*) и предел одного файла.
MEDIA_ALLOWED_TYPES=video/*,image/*,audio/*
MAX_MEDIA_SIZE_BYTES=104857600

# ---------------------------------------------------------------- Muse
# Внешние пайплайны. AI-сервис только выстраивает порядок вызовов и не держит
# локальных моделей: GPU на этой подписке недоступен, квота у всех
# GPU-семейств 0/0 и не повышается.
MUSE_SPARK_URL=
MUSE_VISION_URL=
MUSE_VOICE_URL=

# ---------------------------------------------------------------- аутентификация
# Ключи заведены на сервере в /opt/raw2reel/secrets/app.env, их читает бэкенд
# (backend/src/config.ts; basePath /api/auth задан в backend/src/auth.ts).
#
# BETTER_AUTH_URL — базовый адрес, к которому better-auth дописывает свой
# basePath. По умолчанию basePath равен /api/auth, поэтому при базе
# https://raw2reel.studio публичный эндпоинт получается
# https://raw2reel.studio/api/auth/*. Это ровно совпадает с маршрутизацией:
# Caddy снимает префикс /api, и бэкенд получает /auth/*.
BETTER_AUTH_URL=https://raw2reel.studio

# BETTER_AUTH_SECRET — ключ подписи сессий, не меньше 32 символов.
# На сервере стоит 64 hex-символа (256 бит): hex, а не base64, потому что
# + / = неудобны в env-файлах и URL, а энтропии и так с запасом.
# Сгенерировать новый: openssl rand -hex 32
# Смена секрета разлогинивает всех — это ожидаемое поведение, не поломка.
BETTER_AUTH_SECRET=

# Origin, которым разрешены эндпоинты /identity/web/*, через запятую.
#
# ВНИМАНИЕ: список не «дополнительный». Адрес из BETTER_AUTH_URL сюда НЕ
# подставляется, а allowedWebOrigin() в backend/src/app.ts требует, чтобы
# заголовок Origin присутствовал и совпадал с одним из элементов. Пустое
# значение означает «отвергать всё»: любой браузерный запрос к
# /identity/web/* получит 403 ORIGIN_REJECTED. На это уже наступали в проде.
#
# Поэтому собственный адрес сайта нужно указывать явно:
#   BETTER_AUTH_TRUSTED_ORIGINS=https://raw2reel.studio
# Локальный Vite добавляется к нему через запятую, но только в своём .env —
# на сервере localhost быть не должно, иначе страница с машины разработчика
# получит право говорить с продом.
BETTER_AUTH_TRUSTED_ORIGINS=

# ---------------------------------------------------------------- пределы
# Потолок на распаковку входящего изображения. Хост делит 4 GB между всеми
# сервисами, поэтому Pillow ограничивается явно, а не предупреждением.
MAX_IMAGE_PIXELS=50000000
