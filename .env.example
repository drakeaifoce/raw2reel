# Состав конфигурации всех сервисов. Значения здесь не хранятся — только ключи
# и описания. Боевые значения лежат в секретах Gitea Actions, откуда деплой
# рендерит /opt/raw2reel/secrets/app.env на хосте (права 600).
#
# Локально: скопировать в .env рядом с нужным приложением. Корневой .gitignore
# игнорирует .env и .env.*, но этот файл пропускает явным исключением.

# ---------------------------------------------------------------- общее
# Порт внутри контейнера. Снаружи приложения доступны только через Caddy,
# так что менять почти никогда не нужно.
PORT=3000

# ---------------------------------------------------------------- база
# Cosmos DB с Mongo-совместимым API. Строка подключения берётся из портала или
# командой: az cosmosdb keys list --type connection-strings -n <account> -g rg-raw2reel
# Пустое значение не роняет сервис: /ready покажет зависимость как unconfigured.
MONGO_URL=
MONGO_DB=raw2reel

# ---------------------------------------------------------------- файлы
# Azure Blob Storage, аккаунт straw2reel. S3-совместимости у Blob нет:
# в коде используются @azure/storage-blob и azure-storage-blob.
# az storage account show-connection-string -n straw2reel -g rg-raw2reel
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_UPLOADS=uploads
AZURE_BLOB_CONTAINER_RENDERS=renders
# Разбор исходника: ответ /v2/prepare весит до 16 MB и в документ Cosmos
# (предел 2 MB) не влезает, поэтому лежит здесь вместе с превью персонажей.
# У контейнера своё правило жизненного цикла — удаление через 7 дней.
AZURE_BLOB_CONTAINER_ANALYSES=analyses

# Разрешённые MIME-типы (точные значения или группы с /*) и предел одного файла.
MEDIA_ALLOWED_TYPES=video/*,image/*,audio/*
MAX_MEDIA_SIZE_BYTES=104857600

# ---------------------------------------------------------------- Muse
# Серверный ключ Meta Model API. Читается AI-сервисом из MODEL_API_KEY;
# не передавать во frontend. Значение хранится только в окружении/секретах.
MODEL_API_KEY=

# Внешние пайплайны. AI-сервис только выстраивает порядок вызовов и не держит
# локальных моделей: GPU на этой подписке недоступен, квота у всех
# GPU-семейств 0/0 и не повышается.


# ---------------------------------------------------------------- AI-сервис
# Переменные разнесены по сервисам, а не свалены в один файл: на сервере это
# app.env (общее), backend.env и ai.env. Ключ Meta лежит только в ai.env —
# бэкенду он не нужен и видеть его не должен.
#
# Эти две читает бэкенд. Адрес внутренний: ручки /v2/prepare и /v2/render
# снаружи закрыты (Caddy отдаёт на них 404), их зовёт только воркер по сети
# контейнеров. Работа двухфазная: prepare по видео собирает каталог
# персонажей, render по каталогу и выбранным персонажам собирает ролик.
AI_SERVICE_URL=http://ai:8000
# Общий серверный токен: одно и то же значение в backend.env и ai.env.
# Сгенерировать: openssl rand -hex 32
AI_SERVICE_TOKEN=

# ---------------------------------------------------------------- очередь
# NATS с JetStream. Персистентность обязательна: задача рендера живёт минуты,
# и терять её при перезапуске нельзя. Наружу порт не публикуется.
NATS_URL=nats://nats:4222

# Переменные самого AI-сервиса (MODEL_API_KEY, MODEL_*, FFMPEG_*, MEDIA_*)
# описаны отдельно в ai/.env.example и на сервере лежат в ai.env.

# Готовые сэмплы лежат в медиа под служебным владельцем `samples` — отдельной
# переменной для этого нет, имя зашито в backend/src/app.ts. Засев:
# infra/scripts/seed-samples.sh

# ---------------------------------------------------------------- выход к Meta
# Со шведского адреса Meta не отдаёт модели: POST /v1/responses возвращает
# 404 model_not_found на любое имя, даже взятое из её же каталога. С машины в
# другом регионе тот же ключ отвечает 200. Поэтому запросы AI-сервиса идут
# через прокси на отдельной машине, подключённой обратным SSH-туннелем;
# её настройка — в infra/india/.
#
# Читает это сам httpx внутри AI-сервиса: клиент создаётся без trust_env=False,
# то есть переменные окружения он учитывает, и правок кода не требуется.
# Адрес — мост сети raw2reel_edge, туда туннель отдаёт порт прокси.
# Пусто = прямой выход (и неработающие модели, пока ограничение в силе).
HTTPS_PROXY=http://172.18.0.1:8888
# Только петля. Имена контейнеров сюда писать НЕЛЬЗЯ: сравнение идёт по
# окончанию имени хоста, и запись "ai" исключает из проксирования api.meta.ai
# — то есть ровно то, ради чего прокси и заведён. Наступали 03.11.2026:
# внешний адрес показывал Индию, а Meta отвечала 404, потому что запросы к ней
# шли напрямую. Проверять так:
#   docker exec raw2reel-apps-ai-1 python -c \
#     "import urllib.request as u; print(u.proxy_bypass('api.meta.ai'))"
# Должно быть False.
NO_PROXY=127.0.0.1,localhost

