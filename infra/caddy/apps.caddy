# Маршруты приложений. Это НЕ самостоятельный site-блок: файл импортируется
# внутрь блока апекса, который описан на хосте в conf.d/05-apex.caddy и
# репозиторию недоступен. Там же лежит маршрут Gitea — чтобы неудачный деплой
# приложения не мог уронить CI, который этот деплой выполняет.
#
# Деплой кладёт файл в /opt/raw2reel/infra/apps.d/10-apps.caddy.

handle /api/* {
	uri strip_prefix /api
	reverse_proxy backend:3000
}

# Публичный префикс /ml/*, контейнер при этом называется ai: снаружи сервис
# представлен как ML, внутренние имена не переименовывались.
# Снаружи у ML-сервиса открыты ТОЛЬКО проверки состояния. Ручка /v1/render
# гоняет ffmpeg, ходит к Meta и защищена одним общим токеном — выставлять её
# в интернет незачем. Её зовёт воркер по внутренней сети на ai:8000.
# Разбор внутри ОДНОГО handle /ml/*, а не братским route: handle-блоки
# образуют группу взаимного исключения, а route в неё не входит — и тогда
# catch-all фронтенда перехватывает /ml/*, отдавая HTML вместо 404.
# Вложенный матчер проверяется до strip_prefix, иначе сравнивался бы с уже
# переписанным путём.
handle /ml/* {
	@mlPublic path /ml/health /ml/ready /ml/version
	handle @mlPublic {
		uri strip_prefix /ml
		reverse_proxy ai:8000
	}
	handle {
		respond 404
	}
}

handle {
	reverse_proxy frontend:80
}
